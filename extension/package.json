{
  "name": "aegis-security-console",
  "displayName": "Aegis Developer Security Console",
  "description": "Developer-facing security console for Agent Aegis",
  "version": "1.0.0",
  "publisher": "aegis",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegis.configure",
        "title": "Aegis: Set API Key"
      },
      {
        "command": "aegis.clearCredentials",
        "title": "Aegis: Clear Credentials"
      },
      {
        "command": "aegis.openDashboard",
        "title": "Aegis: Open Dashboard"
      },
      {
        "command": "aegis.refresh",
        "title": "Aegis: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "aegis.inspectAction",
        "title": "Aegis: Inspect Action"
      },
      {
        "command": "aegis.approve",
        "title": "Aegis: Approve Action",
        "icon": "$(check)"
      },
      {
        "command": "aegis.deny",
        "title": "Aegis: Deny Action",
        "icon": "$(x)"
      },
      {
        "command": "aegis.runAttackLab",
        "title": "Aegis: Run Attack Lab Scenario"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aegis.refresh",
          "when": "view == aegisOverview",
          "group": "navigation"
        },
        {
          "command": "aegis.refresh",
          "when": "view == aegisApprovals",
          "group": "navigation"
        },
        {
          "command": "aegis.refresh",
          "when": "view == aegisAudit",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aegis.inspectAction",
          "when": "view == aegisApprovals && viewItem == approval",
          "group": "inline"
        },
        {
          "command": "aegis.approve",
          "when": "view == aegisApprovals && viewItem == approval",
          "group": "inline"
        },
        {
          "command": "aegis.deny",
          "when": "view == aegisApprovals && viewItem == approval",
          "group": "inline"
        },
        {
          "command": "aegis.inspectAction",
          "when": "view == aegisAudit && viewItem == auditEvent",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aegis",
          "title": "Aegis Security",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "aegis": [
        {
          "id": "aegisOverview",
          "name": "Security Overview"
        },
        {
          "id": "aegisApprovals",
          "name": "Pending Approvals"
        },
        {
          "id": "aegisAudit",
          "name": "Audit Events"
        }
      ]
    },
    "configuration": {
      "title": "Aegis",
      "properties": {
        "aegis.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the Aegis backend server."
        },
        "aegis.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL of the Aegis Web Dashboard."
        },
        "aegis.notificationLevel": {
          "type": "string",
          "enum": ["NONE", "IMPORTANT", "ALL"],
          "default": "IMPORTANT",
          "description": "Level of threat/approval notifications to display."
        },
        "aegis.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds to auto-refresh security status. Set to 0 to disable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.89.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  }
}
